{
  "name": "openlist-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "vitepress dev",
    "build": "node utils/ensure-full-git.js && vitepress build",
    "preview": "vitepress preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@giscus/vue": "^3.1.1",
    "@vueuse/core": "^12.8.2",
    "gray-matter": "^4.0.3",
    "medium-zoom": "^1.1.0",
    "mermaid": "^12.0.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.6",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{js,ts,mts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
